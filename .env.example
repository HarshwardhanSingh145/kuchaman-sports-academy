# Firebase Configuration
FIREBASE_API_KEY=

# Gemini API Configuration
GEMINI_API_KEY=

# Cashfree Payment Gateway Configuration
# Obtain your App ID & Secret Key from Cashfree Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Set to 'sandbox' for testing, or 'production' for live payments
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
