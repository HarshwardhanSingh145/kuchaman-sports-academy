{
  "entities": {
    "CricketNet": {
      "title": "CricketNet",
      "description": "Represents an individual cricket practice net at the academy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 500 },
        "turfType": { "type": "string", "maxLength": 64 },
        "capacityPerSlot": { "type": "number" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "isBigBox": { "type": "boolean" },
        "pricePerPerson": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "code", "turfType", "capacityPerSlot", "isActive", "order"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Represents a confirmed or recorded player reservation for cricket net or swimming session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sport": { "type": "string", "enum": ["cricket", "swimming"] },
        "resourceId": { "type": "string", "maxLength": 128 },
        "resourceName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "timeRange": { "type": "string", "maxLength": 64 },
        "userName": { "type": "string", "maxLength": 128, "minLength": 2 },
        "userPhone": { "type": "string", "maxLength": 32, "minLength": 7 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "playerCount": { "type": "number" },
        "experienceLevel": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["CONFIRMED", "COMPLETED", "CANCELLED", "AWAITING_VERIFICATION", "PAYMENT_VERIFICATION_FAILED"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "amountPaid": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["PENDING_VERIFICATION", "APPROVED", "REJECTED"] },
        "paymentScreenshot": { "type": "string" },
        "transactionId": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "verifiedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "sport", "resourceId", "resourceName", "date", "timeRange", "userName", "userPhone", "playerCount", "status", "createdAt"]
    },
    "CustomSlot": {
      "title": "CustomSlot",
      "description": "Custom administrator overrides for time slot pricing, status, or capacity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sport": { "type": "string", "enum": ["cricket", "swimming"] },
        "slotKey": { "type": "string", "maxLength": 128 },
        "capacity": { "type": "number" },
        "booked": { "type": "number" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["AVAILABLE", "LIMITED", "FULL", "CLOSED"] },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "sport", "slotKey", "status"]
    },
    "AcademyConfig": {
      "title": "AcademyConfig",
      "description": "Academy operational details, timing, contact metadata, and disabled calendar dates",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "shortName": { "type": "string", "maxLength": 32 },
        "location": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "operatingHours": { "type": "string", "maxLength": 128 },
        "disabledDates": { "type": "array" },
        "upiId": { "type": "string", "maxLength": 64 },
        "upiAccountName": { "type": "string", "maxLength": 128 },
        "upiQrCodeUrl": { "type": "string" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "shortName", "location", "phone"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized staff or administrator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "superadmin", "manager"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered athlete or trainee in Solo, Academic, or School category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "age": { "type": "number" },
        "fatherName": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "contact": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "enum": ["SOLO", "ACADEMIC", "SCHOOL"] },
        "admissionDate": { "type": "string", "maxLength": 16 },
        "admissionTime": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "REMOVED", "REPLACED", "EXPIRED"] },
        "academyName": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 128 },
        "mentorId": { "type": "string", "maxLength": 128 },
        "mentorName": { "type": "string", "maxLength": 128 },
        "mentorContact": { "type": "string", "maxLength": 32 },
        "tenureDurationMonths": { "type": "number" },
        "tenureStartDate": { "type": "string", "maxLength": 16 },
        "tenureEndDate": { "type": "string", "maxLength": 16 },
        "tenureStatus": { "type": "string", "enum": ["IN_PROGRESS", "COMPLETED", "EXTENDED", "TERMINATED"] },
        "certificateId": { "type": "string", "maxLength": 128 },
        "certificateStatus": { "type": "string", "enum": ["NONE", "DRAFT", "PENDING_APPROVAL", "APPROVED", "REJECTED", "ISSUED"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "fatherName", "contact", "category", "admissionDate", "status"]
    },
    "Mentor": {
      "title": "Mentor",
      "description": "Coach or designated institution coordinator managing athlete batches",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "contact": { "type": "string", "maxLength": 32 },
        "organizationName": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["ACADEMIC", "SCHOOL"] },
        "isFirstLogin": { "type": "boolean" },
        "signatureUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "name", "contact", "organizationName", "category", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily sports training session attendance entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "mentorId": { "type": "string", "maxLength": 128 },
        "mentorName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "LEAVE"] },
        "notes": { "type": "string", "maxLength": 256 },
        "markedBy": { "type": "string", "maxLength": 128 },
        "markedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "date", "status", "markedAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Official completion certificate issued by Kuchaman Sports Academy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "certificateNumber": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "fatherName": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["SOLO", "ACADEMIC", "SCHOOL"] },
        "organizationName": { "type": "string", "maxLength": 128 },
        "mentorId": { "type": "string", "maxLength": 128 },
        "mentorName": { "type": "string", "maxLength": 128 },
        "tenureStartDate": { "type": "string", "maxLength": 16 },
        "tenureEndDate": { "type": "string", "maxLength": 16 },
        "attendancePercentage": { "type": "number" },
        "status": { "type": "string", "enum": ["NONE", "DRAFT", "PENDING_APPROVAL", "APPROVED", "REJECTED", "ISSUED"] },
        "ownerName": { "type": "string", "maxLength": 128 },
        "requestedAt": { "type": "string", "maxLength": 64 },
        "requestedBy": { "type": "string", "maxLength": 128 },
        "rejectionReason": { "type": "string", "maxLength": 256 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "issuedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "certificateNumber", "studentId", "studentName", "status"]
    },
    "SignatureConfig": {
      "title": "SignatureConfig",
      "description": "Official Director signature and Academy Seal credentials",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string", "maxLength": 128 },
        "ownerTitle": { "type": "string", "maxLength": 128 },
        "ownerSignatureUrl": { "type": "string" },
        "academySealUrl": { "type": "string" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["ownerName", "ownerTitle"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and activity audit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "time": { "type": "string", "maxLength": 16 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "action", "timestamp", "performedBy", "details"]
    }
  },
  "firestore": {
    "/cricket_nets/{netId}": {
      "schema": { "$ref": "CricketNet" },
      "description": "Collection of cricket practice nets"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "Booking" },
      "description": "Collection of confirmed player bookings and public reservations"
    },
    "/custom_slots/{slotId}": {
      "schema": { "$ref": "CustomSlot" },
      "description": "Custom overrides for specific dates and time slots"
    },
    "/academy_config/{configId}": {
      "schema": { "$ref": "AcademyConfig" },
      "description": "Global operational configuration for the academy"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "AdminUser" },
      "description": "Designated administrator credentials and roles"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "Student" },
      "description": "All registered students across Solo, Academic, and School categories"
    },
    "/mentors/{mentorId}": {
      "schema": { "$ref": "Mentor" },
      "description": "Mentors and institution coordinators"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "AttendanceRecord" },
      "description": "Daily training session attendance logs"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "Certificate" },
      "description": "Official completion certificates and verification states"
    },
    "/signatures/{signatureId}": {
      "schema": { "$ref": "SignatureConfig" },
      "description": "Director authorized signatures and academy seals"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Immutable security and administrative audit log trail"
    }
  }
}
